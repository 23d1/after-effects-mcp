{
  "name": "after-effects-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives Adobe After Effects via ExtendScript over the AppleScript bridge.",
  "type": "module",
  "bin": {
    "after-effects-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "manifest.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-jsx.mjs && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "doctor": "npm run build && node scripts/doctor.mjs"
  },
  "keywords": [
    "mcp",
    "after-effects",
    "extendscript",
    "adobe",
    "motion-graphics"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "os": [
    "darwin",
    "win32"
  ]
}
